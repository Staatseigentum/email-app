{
  "name": "mailwave",
  "version": "0.0.1",
  "description": "MailWave – ein moderner Desktop-E-Mail-Client",
  "main": "./out/main/index.js",
  "author": "Marco Ebner",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Staatseigentum/email-app.git"
  },
  "mailwave": {
    "appId": "de.marcoebner.mailwave",
    "productName": "MailWave",
    "publisher": "Marco Ebner",
    "updateRepo": "Staatseigentum/email-app"
  },
  "scripts": {
    "dev": "node scripts/evite.mjs dev",
    "build": "node scripts/evite.mjs build",
    "start": "node scripts/evite.mjs preview",
    "icon": "node scripts/gen-icon.mjs",
    "pack": "npm run build && node scripts/pack-app.mjs",
    "installer": "npm run pack && node scripts/build-installer.mjs",
    "release": "node scripts/publish-release.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "imapflow": "^1.0.181",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "lucide-react": "^0.474.0",
    "@types/mailparser": "^3.4.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
